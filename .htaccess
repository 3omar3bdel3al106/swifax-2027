Options -MultiViews -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
RewriteEngine On

# امنع فتح فولدر .git لو اترفع بالغلط
RewriteRule (^|/)\.git - [F,L]

# /index.html أو /index  ->  /
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?#] [NC]
RewriteRule ^ / [R=301,L]

# careers.html  ->  /careers
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /careers/  ->  /careers
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /careers  يفتح careers.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# ضغط الملفات عشان الموقع يفتح أسرع
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json font/woff
</IfModule>

# المتصفح يحتفظ بالصور والخطوط سنة، والـ CSS والـ JS أسبوع
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff .woff
</IfModule>
